# Secrets only. `pnpm install` copies this to .env on a fresh clone and never
# overwrites a file you already have.
#
# The channel and the batch size are settings, not secrets, so they are not
# here: they live in config.toml (source.channel_id, source.batch_size). Copy
# config.example.toml to config.toml and edit it there.
#
# The channel can also be changed at runtime in the admin board (/admin), which
# stores an override beside the database. Add --ignore-overrides to a scrape or
# rollup command to ignore that override and use config.toml exactly as written.
#
# A user token works with this tool, but automating a user account
# ("self-botting") breaks Discord's ToS and can get the account actioned —
# see README. A bot token is the sanctioned path, but a bot cannot join a
# group DM and must be invited to a server with read access to the channel.
DISCORD_TOKEN=your_token_here

# ---- the dashboard: OAuth login ---------------------------------------------
# Everything below is only needed to sign in to the site; the scrape and the
# rollups run without it.
#
# The OAuth app's client id. It is public, so it can live here or in
# config.toml ([access].client_id); the loader falls back to DISCORD_CLIENT_ID.
DISCORD_CLIENT_ID=

# The same app's client secret. Never commit this one.
DISCORD_CLIENT_SECRET=

# Signs the session cookie. Any long random string works:
#   openssl rand -hex 32
SESSION_SECRET=

# The Discord id of the first admin — that account gets /admin on first boot.
# Find yours in the client: Settings > Advanced > Developer Mode, then
# right-click your name > Copy User ID.
ADMIN_DISCORD_ID=

# ---- container only ---------------------------------------------------------
# The image's entrypoint fills an empty source.channel_id from this, so a
# Coolify / compose deploy can set the channel without editing the volume. It
# does nothing locally: set source.channel_id in config.toml instead. An
# existing value in config.toml is never overwritten.
CHANNEL_ID=
